# Illocutionary Lifecycles configuration. Copy to .env.
# The Pipecat example servers load the nearest .env. The text and press-to-speak example servers read the shell environment only.

# --- Language model: configure one provider. Azure OpenAI takes precedence if both keys are set.
# IL includes clients for the OpenAI API format and Azure OpenAI only, because one client handles every reply and analyzer call and most providers can be reached through the OpenAI format with OPENAI_BASE_URL.
# Providers without that format require a new client. Local models are configured in code with LocalLLMConfig.
OPENAI_API_KEY=
OPENAI_MODEL=                 # Model name, e.g. gpt-4o-mini
OPENAI_BASE_URL=              # Required, e.g. https://api.openai.com/v1

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=        # https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=      # Deployment name, not model name
AZURE_OPENAI_API_VERSION=     # e.g. 2024-10-21

# --- Azure Speech: required for TTS on both speech mounts and for STT on the press-to-speak mount.
# Azure Speech is the default because it provides what these mounts rely on: interim STT results for the incremental analyzers and word timings for the spoken text. It was also the service used in development.
# Other services can replace it, but only by writing code that supplies the same data, so they are not offered as settings here.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=          # e.g. westeurope

# --- Pipecat STT: set STT_VENDOR to azure, elevenlabs, openai or whisper.
# Only these are listed because each vendor is an explicit branch in PipecatSTTService. Any other Pipecat service can be added there if it emits InterimTranscriptionFrame and TranscriptionFrame.
# Without interim results, as with whisper, conversations work but incremental analyzers receive no input.
# openai and whisper use OPENAI_API_KEY.
ELEVENLABS_API_KEY=           # The secret starting with sk, not the key ID

# --- Example server settings
TTS_VOICE=                    # e.g. en-US-JennyNeural
SPEECH_LANGUAGE=              # Press-to-speak only, e.g. en-US
STT_VENDOR=                   # Pipecat only

# --- WebRTC relays: optional, for clients that cannot reach the server directly.
STUN_URL=                     # stun:<host>:<port>
TURN_URL=                     # turn://<username>:<credential>@<host>:<port>

# --- Azure Cosmos DB: optional, for sessions using the cosmos or cosmos-readonly storage vendor. Requires the cosmos extra.
COSMOS_ENDPOINT=              # https://<account>.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=
